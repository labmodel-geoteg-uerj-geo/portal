{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/mapa",
      "destination": "/public/mapa.html"
    },
    {
      "source": "/catalogo",
      "destination": "/public/catalogo.html"
    },
    {
      "source": "/producao",
      "destination": "/public/producao.html"
    },
    {
      "source": "/submissao",
      "destination": "/public/submissao.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}
