[
  {
    "titulo": "Dissertação NDVI",
    "lat": -22.9,
    "lon": -43.2,
    "link": "#"
  }
]
fetch('js/data.json')
.then(res => res.json())
.then(dados => {

  dados.forEach(t => {
    L.marker([t.lat, t.lon])
      .addTo(map)
      .bindPopup(`<b>${t.titulo}</b><br><a href="${t.link}">Abrir</a>`);
  });

});
