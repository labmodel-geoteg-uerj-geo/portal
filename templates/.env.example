# ==============================================================================
# VARIÁVEIS DE CONFIGURAÇÃO — IDE GEOESPACIAL REPRODUZÍVEL (PADRÃO INDE/OGC)
# Copie para .env e preencha antes de executar ./scripts/install.sh
# ==============================================================================
DOMINIO_IDE=ide.sua-instituicao.edu.br
EMAIL_SSL=contato@sua-instituicao.edu.br
DIRETORIO_PORTAL=/var/www/ide/public
REPO_GIT_PORTAL=https://github.com/labmodel-geoteg-uerj-geo/portal.git

# Banco de Dados (PostGIS local em Docker ou endpoint externo Neon/Supabase/Aiven)
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=ide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE_DB

# GeoServer (JVM calibrada para VPS 4GB-8GB RAM)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE_GS
GEOSERVER_WORKSPACE=ide
GEOSERVER_INITIAL_MEMORY=512m
GEOSERVER_MAXIMUM_MEMORY=2g

# Limites Operacionais
LIMITE_UPLOAD_MB=500M
MODO_MAPA=OGC_WMS
